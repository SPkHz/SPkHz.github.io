{
  "name": "Jekyll",
  "image": "mcr.microsoft.com/devcontainers/jekyll",
  "mounts": [
    "source=${localEnv:HOME}/.config/claude,target=/home/vscode/.config/claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/openai,target=/home/vscode/.config/openai,type=bind,consistency=cached"
  ],
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "build-essential,imagemagick,inotify-tools,jupyter-nbconvert,procps,ruby-full,zlib1g-dev"
    },
    "ghcr.io/devcontainers-extra/features/prettier:1.0.2": {}
  },
  "postAttachCommand": "./bin/entry_point.sh",
  "postCreateCommand": "cp .devcontainer/.gitconfig ~/.gitconfig",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "sissel.shopify-liquid",
        "yzhang.markdown-all-in-one",
        "openai.chatgpt",
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "prettier.configPath": ".prettierrc",
        "editor.formatOnSave": true
      }
    }
  },
  "remoteUser": "vscode"
}