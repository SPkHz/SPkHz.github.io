{
  "name": "Jekyll Pages",
  "image": "mcr.microsoft.com/devcontainers/jekyll@sha256:ad8cbea0eac2e962d416fd51acaf6065730bd4871ee7ae3396176920fb5a9d2c",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24.22.1"
    },
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "imagemagick"
    }
  },
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "runArgs": ["--platform=linux/amd64", "--userns=keep-id", "--security-opt=no-new-privileges"],
  "containerEnv": {
    "BUNDLE_FROZEN": "true"
  },
  "postCreateCommand": "gem install --no-document bundler --version 4.0.15 && bundle _4.0.15_ install",
  "forwardPorts": [4000]
}
