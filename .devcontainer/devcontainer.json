{
  "name": "Jekyll",
  "image": "mcr.microsoft.com/devcontainers/jekyll",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "build-essential,imagemagick,inotify-tools,jupyter-nbconvert,procps,ruby-full,zlib1g-dev"
    },
    "ghcr.io/devcontainers-extra/features/prettier:1.0.2": {}
  },
  "postAttachCommand": "./bin/entry_point.sh",
  "postCreateCommand": ["/bin/sh", "-c", "gem install --no-document bundler --version 4.0.15 && cp .devcontainer/.gitconfig /home/vscode/.gitconfig"],
  "postStartCommand": "BUNDLE_FROZEN=true bundle _4.0.15_ install",
  "containerEnv": {
    "RBENV_VERSION": "system",
    "BUNDLE_FROZEN": "true"
  },
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "sissel.shopify-liquid", "yzhang.markdown-all-in-one", "openai.chatgpt", "Anthropic.claude-code"],
      "settings": {
        "prettier.configPath": ".prettierrc",
        "editor.formatOnSave": true
      }
    }
  },
  "remoteUser": "vscode"
}
