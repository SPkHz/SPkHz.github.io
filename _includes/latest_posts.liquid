<div class="latest-posts">
  {% if page.latest_posts != blank %}
    {% assign latest_posts_size = site.posts | size %}
    {% assign latest_posts = site.posts %}
    {% if page.latest_posts.limit %}
      {% assign latest_posts_limit = page.latest_posts.limit %}
    {% else %}
      {% assign latest_posts_limit = latest_posts_size %}
    {% endif %}

    <div class="latest-posts-list {% if page.latest_posts.scrollable and latest_posts_size > 3 %}scrollable{% endif %}">
      {% for post in latest_posts limit: latest_posts_limit %}
        {% if post.external_source == blank %}
          {% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
        {% else %}
          {% assign read_time = post.feed_content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
        {% endif %}

        <article class="latest-post-card">
          {% if post.redirect == blank %}
            {% assign post_url = post.url | relative_url %}
          {% elsif post.redirect contains '://' %}
            {% assign post_url = post.redirect %}
          {% else %}
            {% assign post_url = post.redirect | relative_url %}
          {% endif %}

          <a href="{{ post_url }}" class="latest-post-link" {% if post.redirect contains '://' %}target="_blank" rel="noopener"{% endif %}>
            {% if post.thumbnail %}
            <div class="latest-post-thumbnail">
              {% include responsive-thumbnail.liquid
                path=post.thumbnail
                alt=post.title
                loading="lazy"
                sizes="(max-width: 576px) 80px, 100px"
              %}
            </div>
            {% endif %}
            <div class="latest-post-content">
              <h4 class="latest-post-title">
                {{ post.title }}
                {% if post.redirect contains '://' %}
                <svg width="0.875rem" height="0.875rem" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" class="external-link-icon">
                  <path d="M17 13.5v6H5v-12h6m3-3h6v6m0-6-9 9" class="icon_svg-stroke" stroke="currentColor" stroke-width="2" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                {% endif %}
              </h4>
              {% if post.description %}
              <p class="latest-post-description">{{ post.description | truncate: 100 }}</p>
              {% endif %}
              <p class="latest-post-meta">
                <span class="meta-date">{{ post.date | date: '%b %d, %Y' }}</span>
                <span class="meta-separator">&middot;</span>
                <span class="meta-read-time">{{ read_time }} min read</span>
              </p>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p>No posts so far...</p>
  {% endif %}
</div>
