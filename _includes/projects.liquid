<article class="card project-row {% if project.img %}has-thumbnail{% endif %}">
  {% if project.img %}
    <a class="project-thumbnail" href="{{ project.url | relative_url }}" tabindex="-1" aria-hidden="true">
      {% include figure.liquid loading="lazy" path=project.img sizes="(min-width: 576px) 160px, 95vw" alt=project.title class="card-img-top" %}
    </a>
  {% endif %}
  <div class="card-body">
    <h3 class="card-title">
      <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">{{ project.title }}</a>
    </h3>
    <p class="card-text">{{ project.description }}</p>
    {% if project.github %}
      <a href="{{ project.github }}" aria-label="Code repository for {{ project.title | escape }}"
        ><i class="fa-brands fa-github" aria-hidden="true"></i> Code</a
      >
    {% endif %}
  </div>
</article>
