<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body>
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <main id="main-content" class="container" tabindex="-1">
      {% if page.toc and page.toc.sidebar %}
        <div class="sidebar-layout sidebar-{{ page.toc.sidebar }}">
          <nav id="toc-sidebar" aria-label="On this page">{% toc %}</nav>
          <div class="sidebar-content">{{ content }}</div>
        </div>
      {% else %}
        {{ content }}
      {% endif %}
    </main>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
